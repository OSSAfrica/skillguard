%% Based on https://gitdiagram.com/ossafrica/skillguard
%% Maintained source map: launchers restrict clients; guard.py dispatches mapped argv.
flowchart TD

subgraph group_scan["Document scanning"]
  node_parser["Document parser<br/>[markdown.go]"]
  node_scorer["Risk scorer<br/>[scorer.go]"]
  node_extract["Command extraction<br/>[commands.go]"]
  node_arguments["Argument parsing<br/>[arguments.go]"]
  node_report["Scan report<br/>[types.go]"]
  node_verification["Reference verification<br/>[verify.go]"]
  node_metadata["Registry metadata<br/>[metadata.go]"]
  node_network["Network broker<br/>[network.go]"]
end

subgraph group_decision["Action decisions"]
  node_assessment["Action assessment<br/>[evaluate.go]"]
  node_inputs["Input resolution<br/>[inputs.go]"]
  node_assessment_json["Policy and JSON validation<br/>[json.go]"]
end

subgraph group_interfaces["Agent interfaces"]
  node_cli["CLI scan<br/>[scan.go]"]
  node_mcp["Local MCP server<br/>[server.go]"]
  node_mcp_command["MCP commands<br/>[mcp.go]"]
  node_native_plugin["OpenCode native plugin<br/>[index.mjs]"]
  node_python_runtime["Shared plugin runtime<br/>[runtime.py]"]
  node_launcher["Protected launchers<br/>[launch.py]"]
end

subgraph group_runtime["Optional controlled execution"]
  node_gate["Controlled install tool<br/>[mcp_install.go]"]
  node_guard["Revalidation and dispatch<br/>[guard.py]"]
  node_install_runtime["Mapped installer<br/>operator-provided isolation"]
  node_withheld["Withhold execution"]
end

node_operator(("Operator"))
node_documents["Skills and docs"]
node_package_registry[("Package registries")]
node_dns["DNS services"]

node_operator -->|"runs scan"| node_cli
node_documents -->|"supplies files"| node_cli
node_cli -->|"parses inputs"| node_parser
node_cli -->|"analyzes content"| node_scorer
node_cli -->|"extracts commands"| node_extract
node_extract -->|"parses arguments"| node_arguments
node_cli -->|"emits findings"| node_report
node_cli -.->|"explicit policy opt-in"| node_verification
node_verification -->|"looks up packages"| node_metadata
node_metadata -->|"bounded HTTPS"| node_network
node_network -->|"queries metadata"| node_package_registry
node_verification -.->|"approved destination DNS only"| node_dns
node_operator -->|"supplies protected policy and context"| node_assessment
node_assessment -->|"validates JSON and policy"| node_assessment_json
node_assessment -->|"resolves dependencies"| node_inputs
node_assessment -.->|"when metadata required"| node_verification
node_operator -->|"starts MCP"| node_mcp_command
node_mcp_command -->|"serves tools"| node_mcp
node_mcp_command -->|"document tool shares scan pipeline"| node_cli
node_mcp_command -.->|"fixed policy and context configured"| node_assessment
node_native_plugin -->|"launches runtime"| node_python_runtime
node_python_runtime -->|"starts scan-only MCP"| node_mcp_command
node_launcher -->|"restricts native executors; starts MCP"| node_mcp_command
node_mcp_command -.->|"all protected guard flags configured"| node_gate
node_gate -->|"exact argv; fixed runtime"| node_guard
node_guard -->|"assesses each call"| node_assessment
node_assessment -->|"decision and bindings"| node_guard
node_guard -->|"fresh complete allow; hashes unchanged"| node_install_runtime
node_guard -->|"review, deny, partial, error or changed"| node_withheld
node_install_runtime -.->|"installs package"| node_package_registry

